{
  "multipart": [
    {
      "apply": {
        "model": "sonicraft:crisis_city_handrail_post"
      }
    },
    {
      "when": {
        "north": true
      },
      "apply": {
        "model": "sonicraft:crisis_city_handrail_side"
      }
    },
    {
      "when": {
        "east": true
      },
      "apply": {
        "model": "sonicraft:crisis_city_handrail_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": true
      },
      "apply": {
        "model": "sonicraft:crisis_city_handrail_side_alt"
      }
    },
    {
      "when": {
        "west": true
      },
      "apply": {
        "model": "sonicraft:crisis_city_handrail_side_alt",
        "y": 90
      }
    },
    {
      "when": {
        "north": false
      },
      "apply": {
        "model": "sonicraft:crisis_city_handrail_noside"
      }
    },
    {
      "when": {
        "east": false
      },
      "apply": {
        "model": "sonicraft:crisis_city_handrail_noside_alt"
      }
    },
    {
      "when": {
        "south": false
      },
      "apply": {
        "model": "sonicraft:crisis_city_handrail_noside_alt",
        "y": 90
      }
    },
    {
      "when": {
        "west": false
      },
      "apply": {
        "model": "sonicraft:crisis_city_handrail_noside",
        "y": 270
      }
    }
  ]
}
